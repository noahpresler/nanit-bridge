# Linux (systemd): the job. Pair it with miara-bridge.timer.
#
# User install:
#   cp miara-bridge.service miara-bridge.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now miara-bridge.timer
#   journalctl --user -u miara-bridge.service     (the log)
[Unit]
Description=Send my device's data to Miara

[Service]
Type=oneshot
WorkingDirectory=%h/miara-bridge
EnvironmentFile=%h/miara-bridge/.env
ExecStart=/usr/bin/python3 bridge.py
