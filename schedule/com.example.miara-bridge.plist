<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS: run the bridge every 15 minutes.

  1. Copy to ~/Library/LaunchAgents/com.example.miara-bridge.plist
  2. Change both /Users/you/miara-bridge paths.
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.miara-bridge.plist
  Stop it: launchctl bootout gui/$(id -u)/com.example.miara-bridge

  launchd doesn't read .env, so the command loads it first.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.miara-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; . ./.env; set +a; exec /usr/bin/python3 bridge.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/you/miara-bridge</string>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/you/miara-bridge/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/miara-bridge/bridge.log</string>
</dict>
</plist>
