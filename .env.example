# Copy to .env (kept out of git) and fill in.

# A Miara token: in the app, Profile → Siri, assistants and connections → New connection.
# Scopes: read, write:events, write:observations. Limit it to the children below.
MIARA_TOKEN=

# Each Nanit baby to its Miara child: <Nanit uid>=<Miara child id>, comma separated.
# ./install.sh fills these in for you.
MIARA_CHILDREN=

# Optional. Talk to the camera on your network instead of through Nanit's cloud for room readings.
# NANIT_CAMERA_IP=192.168.1.40

# Optional. Also send naps someone logged in the Nanit app (off: they'd overlap what you log in Miara).
# NANIT_INCLUDE_LOGS=1
